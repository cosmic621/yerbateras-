# ── BASE DE DATOS ─────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yerbateras
DB_USER=postgres
DB_PASS=tu_password_aqui

# ── JWT ────────────────────────────────────
JWT_SECRET=yerbateras_super_secret_key_2026_cambiar_en_produccion

# ── WOMPI (pasarela de pagos: Nequi, PSE, tarjetas) ──
# Sacas estas 3 llaves de tu Dashboard de Wompi > Desarrolladores.
# Mientras pruebas usa las de Sandbox (empiezan con _test_); cuando
# tengas todo probado, cambia a las de producción (empiezan con _prod_)
# y cambia tambien WOMPI_API_URL de sandbox a production.
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_KEY=test_integrity_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_EVENTS_KEY=test_events_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_API_URL=https://sandbox.wompi.co/v1

# ── GOOGLE OAUTH ───────────────────────────
GOOGLE_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXX

# ── EMAIL (Gmail App Password) ─────────────
EMAIL_USER=info@yerbateras.co
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
# EMAIL_NEGOCIO: a donde llegan las alertas de nuevas citas (puede ser igual a EMAIL_USER)
EMAIL_NEGOCIO=info@yerbateras.co

# ── TWILIO (SMS OTP) ───────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE=+15005550006

# ── TWILIO WHATSAPP (OPCIONAL — no necesario, tiene costo por mensaje) ─
# El negocio y el cliente YA reciben notificacion gratis por correo (ver
# EMAIL_NEGOCIO arriba). Esto es un canal EXTRA, solo si mas adelante
# decides pagar por WhatsApp automatico. Si dejas esto vacio, no pasa nada.
TWILIO_WHATSAPP_FROM=
WHATSAPP_NEGOCIO=

# ── APP ────────────────────────────────────
PORT=3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
